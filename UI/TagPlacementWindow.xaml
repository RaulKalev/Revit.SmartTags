<Window
    x:Class="SmartTags.UI.TagPlacementWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:ui="clr-namespace:SmartTags.UI"
    Title="Smart Tags"
    Width="460"
    Background="{DynamicResource Window.Background}"
    ResizeMode="CanMinimize"
    SizeToContent="Height"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True">
    <!--
        Standard Windows frame (DWM shadow, Windows 11 rounded corners, Alt+Space, Win+arrows) with the caption area
        drawn by SmartTags. No AllowsTransparency: layered windows are unstable inside Revit. Modeless: shown with Show().
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="44"
            CornerRadius="0"
            GlassFrameThickness="0,0,0,1"
            NonClientFrameEdges="None"
            ResizeBorderThickness="0"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  The palette is swapped at runtime by LoadTheme(); styles use DynamicResource  -->
                <ResourceDictionary Source="pack://application:,,,/SmartTags;component/UI/Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/SmartTags;component/UI/Themes/SmartTagsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Preset actions that need a chosen preset (delete, export)  -->
            <Style
                x:Key="Button.PresetAction"
                BasedOn="{StaticResource Button.Icon}"
                TargetType="{x:Type Button}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedItem, ElementName=PresetComboBox}" Value="{x:Null}">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid
        x:Name="RootGrid"
        Opacity="0"
        TextElement.FontFamily="{StaticResource Font.Text}"
        TextElement.FontSize="{StaticResource FontSize.Body}"
        TextElement.Foreground="{DynamicResource Text.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ============ Title area (draggable caption) ============  -->
        <DockPanel Height="44" Background="Transparent">
            <StackPanel
                VerticalAlignment="Top"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="ThemeButton"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Switch between dark and light appearance"
                    Click="ToggleTheme_Click"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Switch between dark and light appearance"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon
                        x:Name="ThemeIcon"
                        Width="16"
                        Height="16"
                        Kind="WeatherNight" />
                </Button>
                <Button
                    AutomationProperties.Name="Minimize"
                    Click="Minimize_Click"
                    Style="{StaticResource CaptionButton}"
                    ToolTip="Minimize">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        Kind="WindowMinimize" />
                </Button>
                <Button
                    AutomationProperties.Name="Close"
                    Click="Close_Click"
                    Style="{StaticResource CaptionCloseButton}"
                    ToolTip="Close">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        Kind="WindowClose" />
                </Button>
            </StackPanel>

            <TextBlock
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource Type.Title}"
                Text="Smart Tags" />
        </DockPanel>

        <!--  ============ Preset ============  -->
        <Grid Grid.Row="1" Margin="16,2,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Margin="0,0,12,0"
                Style="{StaticResource Type.Label}"
                Text="Preset" />
            <ComboBox
                x:Name="PresetComboBox"
                Grid.Column="1"
                AutomationProperties.Name="Preset"
                DisplayMemberPath="."
                ItemsSource="{Binding Presets}"
                SelectionChanged="PresetComboBox_SelectionChanged"
                Style="{StaticResource Input.Combo}" />
            <StackPanel
                Grid.Column="2"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    AutomationProperties.Name="Save settings as preset"
                    Click="AddPresetButton_Click"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Save the current settings as a preset">
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        Kind="Plus" />
                </Button>
                <Button
                    AutomationProperties.Name="Delete preset"
                    Click="DeletePresetButton_Click"
                    Style="{StaticResource Button.PresetAction}"
                    ToolTip="Delete the selected preset">
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        Kind="Minus" />
                </Button>
                <Button
                    AutomationProperties.Name="Load preset from file"
                    Click="LoadPresetButton_Click"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Load a preset from a file">
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        Kind="FolderOpenOutline" />
                </Button>
                <Button
                    AutomationProperties.Name="Export preset to file"
                    Click="ExportPresetButton_Click"
                    Style="{StaticResource Button.PresetAction}"
                    ToolTip="Export the selected preset to a file">
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        Kind="Export" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  ============ Sections ============  -->
        <ScrollViewer
            Grid.Row="2"
            Focusable="False"
            HorizontalScrollBarVisibility="Disabled"
            PreviewMouseDown="Background_PreviewMouseDown"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,0,16,4">

                <!--  Tag selection  -->
                <Expander
                    x:Name="TagSelectionExpander"
                    AutomationProperties.Name="Tag selection"
                    Collapsed="CardExpander_Toggled"
                    Expanded="CardExpander_Toggled"
                    IsExpanded="True"
                    Style="{StaticResource Section}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TagOutline" Style="{StaticResource SectionIcon}" />
                            <TextBlock Text="Tag selection" />
                        </StackPanel>
                    </Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource Form.LabelWidth}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource Type.Label}" Text="Element category" />
                        <ComboBox
                            x:Name="CategoryComboBox"
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            AutomationProperties.Name="Element category"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding TagCategories}"
                            SelectionChanged="CategoryComboBox_SelectionChanged"
                            Style="{StaticResource Input.Combo}" />

                        <TextBlock
                            x:Name="TagTypeLabelText"
                            Grid.Row="1"
                            Style="{StaticResource Type.Label}"
                            Text="Tag family + type" />
                        <ComboBox
                            x:Name="TagTypeComboBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            ui:ComboBoxSearch.IsEnabled="True"
                            AutomationProperties.Name="Tag type"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding TagTypes}"
                            Style="{StaticResource Input.Combo}" />

                        <CheckBox
                            x:Name="IncludeLinksCheckBox"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,2,0,8"
                            Content="Include elements from links"
                            IsChecked="False"
                            Style="{StaticResource Input.Check}" />

                        <!--  Wire only: treat wires as detail lines  -->
                        <CheckBox
                            x:Name="TreatWireAsDetailLineCheckBox"
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="0,2,0,8"
                            Checked="TreatWireAsDetailLine_Changed"
                            Content="Treat as detail lines"
                            IsChecked="False"
                            Style="{StaticResource Input.Check}"
                            Unchecked="TreatWireAsDetailLine_Changed"
                            Visibility="Collapsed" />
                        <!--  Wire diagnostic (dev only, hidden by default)  -->
                        <Button
                            x:Name="WireDiagnosticButton"
                            Grid.Row="3"
                            Grid.Column="1"
                            Height="{StaticResource Size.ControlSmall}"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Right"
                            Click="WireDiagnosticButton_Click"
                            Content="Diagnose"
                            Style="{StaticResource Button.Secondary}"
                            Visibility="Collapsed" />

                        <!--  Detail lines (Detail Lines category, or wires treated as detail lines)  -->
                        <TextBlock
                            x:Name="DetailLineOffsetLabel"
                            Grid.Row="4"
                            Style="{StaticResource Type.Label}"
                            Text="Offset"
                            Visibility="Collapsed" />
                        <Grid
                            x:Name="DetailLineOffsetGrid"
                            Grid.Row="4"
                            Grid.Column="1"
                            Width="120"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed">
                            <TextBox
                                x:Name="DetailLineOffsetTextBox"
                                AutomationProperties.Name="Offset in millimetres"
                                Style="{StaticResource Input.Number}"
                                Tag="0"
                                Text="0" />
                            <TextBlock Style="{StaticResource Type.Unit}" Text="mm" />
                        </Grid>

                        <TextBlock
                            x:Name="DetailLineDirectionLabel"
                            Grid.Row="5"
                            Style="{StaticResource Type.Label}"
                            Text="Offset direction"
                            Visibility="Collapsed" />
                        <Border
                            x:Name="DetailLineDirectionPanel"
                            Grid.Row="5"
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            Style="{StaticResource Segmented}"
                            Visibility="Collapsed">
                            <UniformGrid Rows="1">
                                <RadioButton
                                    x:Name="DetailLineOffsetUpRadio"
                                    Content="Up"
                                    GroupName="DetailLineOffsetDir"
                                    Style="{StaticResource Segment}" />
                                <RadioButton
                                    x:Name="DetailLineOffsetDownRadio"
                                    Content="Down"
                                    GroupName="DetailLineOffsetDir"
                                    Style="{StaticResource Segment}" />
                                <RadioButton
                                    x:Name="DetailLineOffsetLeftRadio"
                                    Content="Left"
                                    GroupName="DetailLineOffsetDir"
                                    Style="{StaticResource Segment}" />
                                <RadioButton
                                    x:Name="DetailLineOffsetRightRadio"
                                    Content="Right"
                                    GroupName="DetailLineOffsetDir"
                                    IsChecked="True"
                                    Style="{StaticResource Segment}" />
                            </UniformGrid>
                        </Border>

                        <CheckBox
                            x:Name="DetailLineAlignToLineCheckBox"
                            Grid.Row="6"
                            Grid.Column="1"
                            Margin="0,2,0,8"
                            Content="Align item to line direction"
                            IsChecked="False"
                            Style="{StaticResource Input.Check}"
                            Visibility="Collapsed" />
                    </Grid>
                </Expander>

                <!--  Direction tag override  -->
                <Expander
                    x:Name="DirectionTagOverrideExpander"
                    AutomationProperties.Name="Direction tag override"
                    Collapsed="CardExpander_Toggled"
                    Expanded="CardExpander_Toggled"
                    Style="{StaticResource Section}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SwapHorizontal" Style="{StaticResource SectionIcon}" />
                            <TextBlock Text="Direction tag override" />
                            <!--  Hover help: how direction tag types are found and used  -->
                            <Border
                                Margin="6,0,0,0"
                                Padding="2"
                                VerticalAlignment="Center"
                                AutomationProperties.HelpText="Uses a different tag type for each placement direction. Check finds tag types of the chosen category whose type name contains Left, Right, Up or Down."
                                AutomationProperties.Name="How direction tag override works"
                                Background="Transparent"
                                Cursor="Help"
                                ToolTipService.InitialShowDelay="150"
                                ToolTipService.ShowDuration="60000">
                                <materialDesign:PackIcon
                                    Width="14"
                                    Height="14"
                                    Foreground="{DynamicResource Text.Tertiary}"
                                    Kind="InformationOutline" />
                                <Border.ToolTip>
                                    <StackPanel MaxWidth="300">
                                        <StackPanel.Resources>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="LineHeight" Value="16" />
                                            </Style>
                                        </StackPanel.Resources>
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            FontWeight="SemiBold"
                                            Text="Direction tag override" />
                                        <TextBlock Margin="0,0,0,6" Text="Uses a different tag type for each placement direction, for example a tag that reads to the left when tags go left." />
                                        <TextBlock Margin="0,0,0,6" Text="• Finding types: Check looks through the tag types of the chosen element category. A type is used for a direction when its type name (not the family name) contains Left, Right, Up or Down, in any letter case. The first match wins." />
                                        <TextBlock Margin="0,0,0,6" Text="• It also runs by itself when the category changes. Pick a different type in any of the four lists to override the match." />
                                        <TextBlock Margin="0,0,0,6" Text="• Placing: the type for the chosen Placement direction replaces the tag family + type from Tag selection. A direction with no type uses the Tag selection type." />
                                        <TextBlock Foreground="{DynamicResource Text.Secondary}" Text="Note: the keyword does not narrow the search yet: any type name containing the direction word matches. Short words also match inside longer ones, such as up in Group." />
                                    </StackPanel>
                                </Border.ToolTip>
                            </Border>
                        </StackPanel>
                    </Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource Form.LabelWidth}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource Type.Label}" Text="Keyword" />
                        <TextBox
                            x:Name="DirectionKeywordTextBox"
                            Grid.Column="1"
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Direction keyword"
                            Style="{StaticResource Input.Text}"
                            Tag="e.g. Tag"
                            Text=""
                            TextChanged="DirectionKeywordTextBox_TextChanged" />
                        <Button
                            x:Name="DirectionCheckButton"
                            Grid.Column="2"
                            Margin="0,0,0,8"
                            Click="DirectionCheckButton_Click"
                            Content="Check"
                            Style="{StaticResource Button.Secondary}"
                            ToolTip="Find the Left / Right / Up / Down tag types for this keyword" />

                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource Type.Label}"
                            Text="Left" />
                        <ComboBox
                            x:Name="LeftTagTypeComboBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,8"
                            AutomationProperties.Name="Left tag type"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding LeftTagTypes}"
                            Style="{StaticResource Input.Combo}" />

                        <TextBlock
                            Grid.Row="2"
                            Style="{StaticResource Type.Label}"
                            Text="Right" />
                        <ComboBox
                            x:Name="RightTagTypeComboBox"
                            Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,8"
                            AutomationProperties.Name="Right tag type"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding RightTagTypes}"
                            Style="{StaticResource Input.Combo}" />

                        <TextBlock
                            Grid.Row="3"
                            Style="{StaticResource Type.Label}"
                            Text="Up" />
                        <ComboBox
                            x:Name="UpTagTypeComboBox"
                            Grid.Row="3"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,8"
                            AutomationProperties.Name="Up tag type"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding UpTagTypes}"
                            Style="{StaticResource Input.Combo}" />

                        <TextBlock
                            Grid.Row="4"
                            Style="{StaticResource Type.Label}"
                            Text="Down" />
                        <ComboBox
                            x:Name="DownTagTypeComboBox"
                            Grid.Row="4"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,8"
                            AutomationProperties.Name="Down tag type"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding DownTagTypes}"
                            Style="{StaticResource Input.Combo}" />
                    </Grid>
                </Expander>

                <!--  Placement  -->
                <Expander
                    x:Name="PlacementOptionsExpander"
                    AutomationProperties.Name="Placement"
                    Collapsed="CardExpander_Toggled"
                    Expanded="CardExpander_Toggled"
                    IsExpanded="True"
                    Style="{StaticResource Section}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CrosshairsGps" Style="{StaticResource SectionIcon}" />
                            <TextBlock Text="Placement" />
                        </StackPanel>
                    </Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource Form.LabelWidth}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Direction: at most one (exclusive in code); clicking the active one clears it  -->
                        <TextBlock Style="{StaticResource Type.Label}" Text="Direction" />
                        <Border
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            AutomationProperties.Name="Placement direction"
                            Style="{StaticResource Segmented}">
                            <UniformGrid Rows="1">
                                <CheckBox
                                    x:Name="PlacementUpCheckBox"
                                    Checked="PlacementDirection_Checked"
                                    Unchecked="PlacementDirection_Unchecked"
                                    Content="Up"
                                    Style="{StaticResource Segment}" />
                                <CheckBox
                                    x:Name="PlacementDownCheckBox"
                                    Checked="PlacementDirection_Checked"
                                    Unchecked="PlacementDirection_Unchecked"
                                    Content="Down"
                                    Style="{StaticResource Segment}" />
                                <CheckBox
                                    x:Name="PlacementLeftCheckBox"
                                    Checked="PlacementDirection_Checked"
                                    Unchecked="PlacementDirection_Unchecked"
                                    Content="Left"
                                    Style="{StaticResource Segment}" />
                                <CheckBox
                                    x:Name="PlacementRightCheckBox"
                                    Checked="PlacementDirection_Checked"
                                    Unchecked="PlacementDirection_Unchecked"
                                    Content="Right"
                                    Style="{StaticResource Segment}" />
                            </UniformGrid>
                        </Border>

                        <!--  Leader: type + length (length also sets the offset when the leader is off)  -->
                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource Type.Label}"
                            Text="Leader" />
                        <Grid
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="LeaderTypeComboBox"
                                Margin="0,0,8,0"
                                AutomationProperties.Name="Leader end"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding LeaderTypes}"
                                Style="{StaticResource Input.Combo}" />
                            <Grid Grid.Column="1" ToolTip="Leader length. Also used as the tag offset when the leader is off.">
                                <TextBox
                                    x:Name="LeaderLengthTextBox"
                                    AutomationProperties.Name="Leader length in millimetres"
                                    Style="{StaticResource Input.Number}"
                                    Tag="Length"
                                    Text="0" />
                                <TextBlock Style="{StaticResource Type.Unit}" Text="mm" />
                            </Grid>
                        </Grid>
                        <CheckBox
                            x:Name="LeaderLineCheckBox"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,0,0,10"
                            Checked="LeaderLineCheckBox_Toggled"
                            Content="Leader line"
                            IsChecked="True"
                            Style="{StaticResource Input.Check}"
                            Unchecked="LeaderLineCheckBox_Toggled" />

                        <!--  Orientation: type + angle  -->
                        <TextBlock
                            Grid.Row="3"
                            Style="{StaticResource Type.Label}"
                            Text="Orientation" />
                        <Grid
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="OrientationComboBox"
                                Margin="0,0,8,0"
                                AutomationProperties.Name="Orientation"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding OrientationOptions}"
                                Style="{StaticResource Input.Combo}" />
                            <Grid Grid.Column="1">
                                <TextBox
                                    x:Name="AngleTextBox"
                                    AutomationProperties.Name="Angle in degrees"
                                    Style="{StaticResource Input.Number}"
                                    Tag="Angle"
                                    Text="0" />
                                <TextBlock Style="{StaticResource Type.Unit}" Text="°" />
                            </Grid>
                        </Grid>
                        <CheckBox
                            x:Name="DetectRotationCheckBox"
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="0,0,0,12"
                            Content="Detect element rotation"
                            IsChecked="False"
                            Style="{StaticResource Input.Check}" />

                        <!--  Anchor: nine points on the tag outline  -->
                        <TextBlock
                            Grid.Row="5"
                            Margin="0,6,12,8"
                            VerticalAlignment="Top"
                            Style="{StaticResource Type.Label}"
                            Text="Anchor" />
                        <Border
                            Grid.Row="5"
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            Padding="6"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Anchor point"
                            Style="{StaticResource InsetCard}">
                            <Grid Width="104" Height="66">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!--  Tag outline through the dot centres  -->
                                <Rectangle
                                    Grid.RowSpan="3"
                                    Grid.ColumnSpan="3"
                                    Margin="11"
                                    RadiusX="2"
                                    RadiusY="2"
                                    Stroke="{DynamicResource Text.Tertiary}"
                                    StrokeDashArray="3 3"
                                    StrokeThickness="1" />

                                <RadioButton
                                    x:Name="AnchorTopLeftRadio"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    AutomationProperties.Name="Top left"
                                    Checked="AnchorPoint_Checked"
                                    GroupName="AnchorPoint"
                                    Style="{StaticResource AnchorDot}"
                                    ToolTip="Top left" />
                                <RadioButton
                                    x:Name="AnchorTopCenterRadio"
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    AutomationProperties.Name="Top centre"
                                    Checked="AnchorPoint_Checked"
                                    GroupName="AnchorPoint"
                                    Style="{StaticResource AnchorDot}"
                                    ToolTip="Top centre" />
                                <RadioButton
                                    x:Name="AnchorTopRightRadio"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    AutomationProperties.Name="Top right"
                                    Checked="AnchorPoint_Checked"
                                    GroupName="AnchorPoint"
                                    Style="{StaticResource AnchorDot}"
                                    ToolTip="Top right" />

                                <RadioButton
                                    x:Name="AnchorLeftCenterRadio"
                                    Grid.Row="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Middle left"
                                    Checked="AnchorPoint_Checked"
                                    GroupName="AnchorPoint"
                                    Style="{StaticResource AnchorDot}"
                                    ToolTip="Middle left" />
                                <RadioButton
                                    x:Name="AnchorCenterRadio"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Centre"
                                    Checked="AnchorPoint_Checked"
                                    GroupName="AnchorPoint"
                                    IsChecked="True"
                                    Style="{StaticResource AnchorDot}"
                                    ToolTip="Centre" />
                                <RadioButton
                                    x:Name="AnchorRightCenterRadio"
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Middle right"
                                    Checked="AnchorPoint_Checked"
                                    GroupName="AnchorPoint"
                                    Style="{StaticResource AnchorDot}"
                                    ToolTip="Middle right" />

                                <RadioButton
                                    x:Name="AnchorBottomLeftRadio"
                                    Grid.Row="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    AutomationProperties.Name="Bottom left"
                                    Checked="AnchorPoint_Checked"
                                    GroupName="AnchorPoint"
                                    Style="{StaticResource AnchorDot}"
                                    ToolTip="Bottom left" />
                                <RadioButton
                                    x:Name="AnchorBottomCenterRadio"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    AutomationProperties.Name="Bottom centre"
                                    Checked="AnchorPoint_Checked"
                                    GroupName="AnchorPoint"
                                    Style="{StaticResource AnchorDot}"
                                    ToolTip="Bottom centre" />
                                <RadioButton
                                    x:Name="AnchorBottomRightRadio"
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    AutomationProperties.Name="Bottom right"
                                    Checked="AnchorPoint_Checked"
                                    GroupName="AnchorPoint"
                                    Style="{StaticResource AnchorDot}"
                                    ToolTip="Bottom right" />
                            </Grid>
                        </Border>

                    </Grid>
                </Expander>

                <!--  Collision avoidance  -->
                <Expander
                    x:Name="CollisionDetectionExpander"
                    AutomationProperties.Name="Collision avoidance"
                    Collapsed="CardExpander_Toggled"
                    Expanded="CardExpander_Toggled"
                    Style="{StaticResource Section}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="VectorSquare" Style="{StaticResource SectionIcon}" />
                            <TextBlock Text="Collision avoidance" />
                        </StackPanel>
                    </Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource Form.LabelWidth}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource Type.Label}" Text="Avoid collisions" />
                        <CheckBox
                            x:Name="CollisionDetectionCheckBox"
                            Grid.Column="1"
                            Height="{StaticResource Size.Control}"
                            Margin="0,0,0,8"
                            AutomationProperties.Name="Avoid collisions"
                            Checked="CollisionDetectionCheckBox_Toggled"
                            IsChecked="False"
                            Style="{StaticResource Input.Switch}"
                            ToolTip="Move tags clear of elements and other tags"
                            Unchecked="CollisionDetectionCheckBox_Toggled" />

                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource Type.Label}"
                            Text="Gap" />
                        <Grid
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="120"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left">
                            <TextBox
                                x:Name="CollisionGapTextBox"
                                AutomationProperties.Name="Gap in millimetres"
                                IsEnabled="False"
                                Style="{StaticResource Input.Number}"
                                Tag="Gap"
                                Text="1" />
                            <TextBlock Style="{StaticResource Type.Unit}" Text="mm" />
                        </Grid>

                        <TextBlock
                            Grid.Row="2"
                            Style="{StaticResource Type.Label}"
                            Text="Minimum offset" />
                        <Grid
                            Grid.Row="2"
                            Grid.Column="1"
                            Width="120"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            ToolTip="Distance from the element when the tag has no leader">
                            <TextBox
                                x:Name="MinimumOffsetTextBox"
                                AutomationProperties.Name="Minimum offset in millimetres"
                                Style="{StaticResource Input.Number}"
                                Tag="Offset"
                                Text="300" />
                            <TextBlock Style="{StaticResource Type.Unit}" Text="mm" />
                        </Grid>
                    </Grid>
                </Expander>

                <!--  Retag / normalize  -->
                <Expander
                    x:Name="RetagNormalizeExpander"
                    AutomationProperties.Name="Retag and normalize"
                    Collapsed="CardExpander_Toggled"
                    Expanded="CardExpander_Toggled"
                    Style="{StaticResource Section}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Autorenew" Style="{StaticResource SectionIcon}" />
                            <TextBlock Text="Retag / normalize" />
                        </StackPanel>
                    </Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource Form.LabelWidth}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Execution mode (exclusive in code)  -->
                        <TextBlock Style="{StaticResource Type.Label}" Text="Apply changes" />
                        <Border
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            AutomationProperties.Name="Execution mode"
                            Style="{StaticResource Segmented}">
                            <UniformGrid Rows="1">
                                <CheckBox
                                    x:Name="RetagFullyAutomaticCheckBox"
                                    Checked="RetagExecutionMode_Changed"
                                    Unchecked="RetagExecutionMode_Unchecked"
                                    Content="Automatically"
                                    IsChecked="True"
                                    Style="{StaticResource Segment}"
                                    ToolTip="Apply every change without asking" />
                                <CheckBox
                                    x:Name="RetagUserConfirmationCheckBox"
                                    Checked="RetagExecutionMode_Changed"
                                    Unchecked="RetagExecutionMode_Unchecked"
                                    Content="Confirm each"
                                    IsChecked="False"
                                    Style="{StaticResource Segment}"
                                    ToolTip="Review each change before it is applied" />
                            </UniformGrid>
                        </Border>

                        <UniformGrid
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            Columns="2">
                            <Button
                                Margin="0,0,4,0"
                                Click="RetagSelectedButton_Click"
                                Content="Retag selected"
                                Style="{StaticResource Button.Secondary}"
                                ToolTip="Re-place the selected tags with the current settings" />
                            <Button
                                Margin="4,0,0,0"
                                Click="NormalizeViewButton_Click"
                                Content="Normalize view"
                                Style="{StaticResource Button.Secondary}"
                                ToolTip="Re-place every tag in the active view with the current settings" />
                        </UniformGrid>
                    </Grid>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!--  ============ Feedback line: result of the last action (glyph + text) ============  -->
        <DockPanel
            x:Name="StatusLine"
            Grid.Row="3"
            Margin="18,2,18,8"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Status"
            Visibility="Collapsed">
            <materialDesign:PackIcon
                Width="15"
                Height="15"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource Status.Ok}"
                Kind="CheckCircleOutline" />
            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                Foreground="{DynamicResource Text.Secondary}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </DockPanel>

        <!--  ============ Action bar (toolbar material) ============  -->
        <Border
            Grid.Row="4"
            Padding="16,10,16,12"
            Background="{DynamicResource Toolbar.Material}"
            BorderBrush="{DynamicResource Separator}"
            BorderThickness="0,1,0,0">
            <DockPanel>
                <CheckBox
                    x:Name="SkipIfTaggedCheckBox"
                    Content="Skip tagged"
                    IsChecked="True"
                    Style="{StaticResource Input.Check}"
                    ToolTip="Leave out elements that already have a tag of this category in the view (Select, Tag all and Tag selected)" />
                <StackPanel
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button
                        x:Name="ActiveSelectionToggleButton"
                        MinWidth="72"
                        Margin="0,0,8,0"
                        Click="ActiveSelectionToggle_Click"
                        Content="Select"
                        Style="{StaticResource Button.Selection}"
                        ToolTip="Tag elements one by one as you click them in the view. Press Esc twice to stop." />
                    <Button
                        MinWidth="72"
                        Margin="0,0,8,0"
                        Click="TagAllButton_Click"
                        Content="Tag all"
                        Style="{StaticResource Button.Secondary}"
                        ToolTip="Tag every element of the category in the active view" />
                    <Button
                        MinWidth="96"
                        Click="TagSelectedButton_Click"
                        Content="Tag selected"
                        Style="{StaticResource Button.Primary}"
                        ToolTip="Tag the elements selected in the view" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  ============ Sheet (in-window, replaces modal message boxes and dialogs) ============  -->
        <Grid
            x:Name="SheetHost"
            Grid.RowSpan="5"
            Visibility="Collapsed">
            <Border Background="{DynamicResource Scrim}" MouseLeftButtonDown="Scrim_MouseDown" />
            <Border
                x:Name="SheetCard"
                Margin="16,48,16,16"
                Padding="20,18,20,16"
                VerticalAlignment="Top"
                KeyboardNavigation.ControlTabNavigation="Cycle"
                KeyboardNavigation.DirectionalNavigation="Contained"
                KeyboardNavigation.TabNavigation="Cycle"
                Style="{StaticResource Floating}">
                <DockPanel>
                    <!--  Secondary left of primary; primary is the default (Enter), secondary cancels (Esc)  -->
                    <DockPanel Margin="0,16,0,0" DockPanel.Dock="Bottom">
                        <!--  Optional third choice on the left, apart from Cancel / primary (e.g. "Don't save")  -->
                        <Button
                            x:Name="SheetTertiary"
                            MinWidth="80"
                            Margin="0,0,8,0"
                            Click="SheetTertiary_Click"
                            DockPanel.Dock="Left"
                            Style="{StaticResource Button.Secondary}"
                            Visibility="Collapsed" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button
                                x:Name="SheetSecondary"
                                MinWidth="80"
                                Margin="0,0,8,0"
                                Click="SheetSecondary_Click"
                                Content="Cancel"
                                Style="{StaticResource Button.Secondary}" />
                            <Button
                                x:Name="SheetPrimary"
                                MinWidth="80"
                                Click="SheetPrimary_Click"
                                Content="OK"
                                Style="{StaticResource Button.Primary}" />
                        </StackPanel>
                    </DockPanel>

                    <materialDesign:PackIcon
                        x:Name="SheetIcon"
                        Width="22"
                        Height="22"
                        Margin="0,0,12,0"
                        VerticalAlignment="Top"
                        Kind="InformationOutline" />

                    <StackPanel>
                        <TextBlock
                            x:Name="SheetTitle"
                            Margin="0,1,0,6"
                            Style="{StaticResource Type.Section}"
                            TextWrapping="Wrap" />
                        <ScrollViewer
                            MaxHeight="320"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="SheetMessage" Style="{StaticResource Type.Body}" />
                        </ScrollViewer>
                        <TextBox
                            x:Name="SheetInput"
                            Margin="0,12,0,0"
                            Style="{StaticResource Input.Text}"
                            TextChanged="SheetInput_TextChanged"
                            Visibility="Collapsed" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
