<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Light appearance (Sentinel palette). Soft window grey with white content surfaces, macOS-like accent and
        status hues tuned for text contrast on white.
    -->

    <!--  Base  -->
    <SolidColorBrush x:Key="Window.Background" Color="#FFF3F3F5" />
    <SolidColorBrush x:Key="Window.Stroke" Color="#FFC9C9CE" />

    <!--  Materials  -->
    <LinearGradientBrush x:Key="Toolbar.Material" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFF8F8FA" />
        <GradientStop Offset="1" Color="#FFF2F2F4" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Floating.Material" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FAFFFFFF" />
        <GradientStop Offset="1" Color="#FAF7F7F9" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Floating.Edge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFFFFFF" />
        <GradientStop Offset="1" Color="#FFDADADF" />
    </LinearGradientBrush>
    <Color x:Key="Shadow.Color">#FF303038</Color>
    <sys:Double x:Key="Shadow.Opacity">0.16</sys:Double>
    <SolidColorBrush x:Key="Scrim" Color="#59202028" />

    <!--  Surfaces  -->
    <SolidColorBrush x:Key="Surface.Content" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Surface.Raised" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Surface.Inset" Color="#FFF6F6F8" />
    <SolidColorBrush x:Key="Surface.Stroke" Color="#FFDCDCE0" />
    <SolidColorBrush x:Key="Separator" Color="#FFE6E6EA" />

    <!--  Controls  -->
    <SolidColorBrush x:Key="Control.Fill" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Control.FillHover" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="Control.FillPressed" Color="#FFE6E6EB" />
    <SolidColorBrush x:Key="Control.Stroke" Color="#FFC8C8CE" />
    <SolidColorBrush x:Key="Control.Plain.Hover" Color="#0F000000" />
    <SolidColorBrush x:Key="Control.Plain.Pressed" Color="#1C000000" />
    <SolidColorBrush x:Key="Input.Fill" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Input.Stroke" Color="#FFC5C5CB" />
    <SolidColorBrush x:Key="Input.StrokeHover" Color="#FF9E9EA6" />
    <SolidColorBrush x:Key="Switch.Off" Color="#FFDCDCE1" />
    <SolidColorBrush x:Key="Switch.Knob" Color="#FFFFFFFF" />

    <!--  Text  -->
    <SolidColorBrush x:Key="Text.Primary" Color="#FF1D1D1F" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#FF5F5F66" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="#FF8A8A91" />
    <SolidColorBrush x:Key="Text.Disabled" Color="#FFB3B3B9" />
    <SolidColorBrush x:Key="Text.OnAccent" Color="#FFFFFFFF" />

    <!--  Accent + focus  -->
    <SolidColorBrush x:Key="Accent" Color="#FF007AFF" />
    <SolidColorBrush x:Key="Accent.Hover" Color="#FF1A88FF" />
    <SolidColorBrush x:Key="Accent.Pressed" Color="#FF0062CC" />
    <SolidColorBrush x:Key="Accent.Subtle" Color="#1F007AFF" />
    <SolidColorBrush x:Key="Accent.Text" Color="#FF0063CC" />
    <SolidColorBrush x:Key="Focus.Ring" Color="#FF007AFF" />

    <!--  Status  -->
    <SolidColorBrush x:Key="Status.Ok" Color="#FF1B8A3A" />
    <SolidColorBrush x:Key="Status.Info" Color="#FF0063CC" />
    <SolidColorBrush x:Key="Status.Warning" Color="#FFB25000" />
    <SolidColorBrush x:Key="Status.Error" Color="#FFC4161C" />
    <SolidColorBrush x:Key="Status.Error.Subtle" Color="#1FFF3B30" />

</ResourceDictionary>
