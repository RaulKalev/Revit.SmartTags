<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Dark appearance (Sentinel palette). Neutral graphite greys with a slight cool cast, macOS-like system accent
        and status hues. Materials are gradients + edge highlights over an opaque window: WPF cannot blur what is
        behind a window, and layered (AllowsTransparency) windows are unstable inside Revit.
    -->

    <!--  Base  -->
    <SolidColorBrush x:Key="Window.Background" Color="#FF1E1E20" />
    <SolidColorBrush x:Key="Window.Stroke" Color="#FF3A3A3E" />

    <!--  Materials  -->
    <LinearGradientBrush x:Key="Toolbar.Material" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF242427" />
        <GradientStop Offset="1" Color="#FF1F1F22" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Floating.Material" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FA38383C" />
        <GradientStop Offset="1" Color="#FA303034" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Floating.Edge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#33FFFFFF" />
        <GradientStop Offset="0.5" Color="#12FFFFFF" />
        <GradientStop Offset="1" Color="#0AFFFFFF" />
    </LinearGradientBrush>
    <Color x:Key="Shadow.Color">#FF000000</Color>
    <sys:Double x:Key="Shadow.Opacity">0.45</sys:Double>
    <SolidColorBrush x:Key="Scrim" Color="#8C000000" />

    <!--  Surfaces  -->
    <SolidColorBrush x:Key="Surface.Content" Color="#FF252528" />
    <SolidColorBrush x:Key="Surface.Raised" Color="#FF2A2A2D" />
    <SolidColorBrush x:Key="Surface.Inset" Color="#FF202023" />
    <SolidColorBrush x:Key="Surface.Stroke" Color="#FF36363A" />
    <SolidColorBrush x:Key="Separator" Color="#FF333337" />

    <!--  Controls  -->
    <SolidColorBrush x:Key="Control.Fill" Color="#FF3A3A3E" />
    <SolidColorBrush x:Key="Control.FillHover" Color="#FF444449" />
    <SolidColorBrush x:Key="Control.FillPressed" Color="#FF2F2F33" />
    <SolidColorBrush x:Key="Control.Stroke" Color="#FF4A4A4F" />
    <SolidColorBrush x:Key="Control.Plain.Hover" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Control.Plain.Pressed" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="Input.Fill" Color="#FF1C1C1F" />
    <SolidColorBrush x:Key="Input.Stroke" Color="#FF46464B" />
    <SolidColorBrush x:Key="Input.StrokeHover" Color="#FF5A5A60" />
    <SolidColorBrush x:Key="Switch.Off" Color="#FF48484D" />
    <SolidColorBrush x:Key="Switch.Knob" Color="#FFF2F2F5" />

    <!--  Text  -->
    <SolidColorBrush x:Key="Text.Primary" Color="#FFF2F2F5" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFA8A8B0" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="#FF7C7C84" />
    <SolidColorBrush x:Key="Text.Disabled" Color="#FF5E5E64" />
    <SolidColorBrush x:Key="Text.OnAccent" Color="#FFFFFFFF" />

    <!--  Accent + focus  -->
    <SolidColorBrush x:Key="Accent" Color="#FF0A84FF" />
    <SolidColorBrush x:Key="Accent.Hover" Color="#FF3395FF" />
    <SolidColorBrush x:Key="Accent.Pressed" Color="#FF0068CC" />
    <SolidColorBrush x:Key="Accent.Subtle" Color="#330A84FF" />
    <SolidColorBrush x:Key="Accent.Text" Color="#FF4DA3FF" />
    <SolidColorBrush x:Key="Focus.Ring" Color="#FF4DA3FF" />

    <!--  Status: text colour + subtle fill (never colour alone - every status also has a glyph and a word)  -->
    <SolidColorBrush x:Key="Status.Ok" Color="#FF32D74B" />
    <SolidColorBrush x:Key="Status.Info" Color="#FF4DA3FF" />
    <SolidColorBrush x:Key="Status.Warning" Color="#FFFFB340" />
    <SolidColorBrush x:Key="Status.Error" Color="#FFFF6961" />
    <SolidColorBrush x:Key="Status.Error.Subtle" Color="#29FF453A" />

</ResourceDictionary>
